{
  "name": "Harvester Editorial Dark",
  "theme": "dark",
  "colors": {
    "canvas": "#0B0A0A",
    "canvas_elevated": "#121010",
    "surface": "rgba(255, 248, 238, 0.045)",
    "surface_strong": "rgba(255, 248, 238, 0.075)",
    "text_primary": "#F4EFE7",
    "text_secondary": "#B8B0A5",
    "text_quiet": "#7E776F",
    "oxblood": "#B93D57",
    "oxblood_bright": "#DE5D72",
    "gold": "#D2AA6D",
    "success": "#72C18B",
    "border": "rgba(255, 248, 238, 0.10)",
    "border_strong": "rgba(255, 248, 238, 0.18)"
  },
  "typography": {
    "display": "Georgia, Charter, Times New Roman, serif",
    "body": "Inter, SF Pro Display, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif",
    "mono": "SFMono-Regular, Menlo, Consolas, monospace",
    "display_weight": 400,
    "body_weight": 400,
    "emphasis_weight": 600
  },
  "geometry": {
    "outer_margin": "96px",
    "grid": "8px",
    "card_radius": "12px",
    "panel_radius": "18px"
  },
  "motion": {
    "scene_in": "650ms cubic-bezier(.16,1,.3,1)",
    "stagger": "90ms",
    "capture_drift": "scale 1.015 to 1.045 over scene",
    "principle": "calm, deliberate, evidence-first"
  },
  "notes": "Premium editorial darkness with oxblood as the primary accent and restrained gold reserved for proof, approval, and final payoff. No gradients used as decoration; glows only establish depth and focus."
}
